{
  "title": "PS5 Watch",
  "currency": "EUR",
  "gta6_date": "2026-11-19",
  "repo": "TU-USUARIO/ps5-tracker",
  "alerts": {
    "drop_pct": 10,
    "rise_pct": 10,
    "median_window_days": 30,
    "cooldown_days": 3,
    "renotify_move_pct": 2,
    "notify_all_time_low": true,
    "notify_target": true,
    "fail_streak_warning": 6
  },
  "providers": {
    "amazon": {
      "name": "Amazon.es",
      "strategies": ["css", "jsonld", "regex"],
      "css": [".a-price .a-offscreen", "#corePrice_feature_div .a-offscreen"],
      "fragile": true
    },
    "mediamarkt": {
      "name": "MediaMarkt",
      "strategies": ["jsonld", "meta", "css", "regex"],
      "css": ["[data-test='branded-price-whole-value']", "[data-test='mms-product-price']"]
    },
    "pccomponentes": {
      "name": "PcComponentes",
      "strategies": ["jsonld", "meta", "css", "regex"],
      "css": ["#pdp-price-current-integer", "[data-e2e='price-container']"]
    },
    "fnac": {
      "name": "Fnac",
      "strategies": ["jsonld", "meta", "css", "regex"],
      "css": [".userPrice", ".f-priceBox-price"]
    },
    "game": {
      "name": "GAME",
      "strategies": ["jsonld", "meta", "css", "regex"],
      "css": [".buy-block__price", ".product-price"]
    },
    "elcorteingles": {
      "name": "El Corte Inglés",
      "strategies": ["jsonld", "meta", "css", "regex"],
      "css": ["[data-synth='PRICE_CONTAINER-PRICE']", ".prices-price"]
    }
  },
